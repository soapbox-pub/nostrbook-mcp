{
  "name": "@nostrbook/mcp",
  "version": "0.1.0",
  "exports": {
    ".": "./src/stdio.ts"
  },
  "tasks": {
    "start": "deno run -A src/stdio.ts",
    "dev": "deno run -A --node-modules-dir npm:@modelcontextprotocol/inspector deno task start",
    "test": "deno test -A",
    "check": "deno check .",
    "lint": "deno lint"
  },
  "imports": {
    "@modelcontextprotocol/sdk": "npm:@modelcontextprotocol/sdk@^1.9.0",
    "@std/assert": "jsr:@std/assert@^1.0.12",
    "zod": "npm:zod@^3.24.2"
  },
  "fmt": {
    "lineWidth": 80,
    "singleQuote": true,
    "proseWrap": "preserve"
  }
}
