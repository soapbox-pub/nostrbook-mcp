{
  "name": "@nostrbook/mcp",
  "version": "0.6.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "mcp": "dist/mcp"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "test": "node --test src/**/*.test.ts",
    "test:integration": "npm run build && node --test tests/*.test.ts",
    "test:live": "node scripts/smoke.ts",
    "verify": "npm run check && npm test && npm run test:integration",
    "build": "node scripts/build.ts",
    "dev": "node src/stdio.ts",
    "check": "tsc --noEmit",
    "prepack": "npm run build",
    "prepublishOnly": "npm run verify"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "ws": "^8.23.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@nostrify/nostrify": "^0.55.1",
    "nostr-tools": "^2.26.1",
    "zod": "^4.6.7"
  }
}
